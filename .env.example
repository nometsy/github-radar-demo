# ─────────────────────────────────────────────────────────────
# GitHub Radar — environment variables
# Copy this file to .env.local and fill in what you need.
# Never commit .env.local. The token never reaches the browser.
# ─────────────────────────────────────────────────────────────

# Optional, strongly recommended.
# A classic Personal Access Token with NO scopes is enough for public data.
# Without it GitHub allows ~60 core requests/hour and 10 searches/minute.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Snapshot storage ─────────────────────────────────────────
# "file"     — zero setup, JSON in RADAR_DATA_DIR (default ./.data)
# "postgres" — PostgreSQL via Prisma (required on Vercel)
RADAR_STORAGE=file

# Optional directory for radar.json and github-cache.json.
# Point it at a mounted persistent volume on Render/Railway, e.g. /var/data.
# On Vercel snapshots require RADAR_STORAGE=postgres; only the disposable
# GitHub cache is written to /tmp automatically.
# RADAR_DATA_DIR=/var/data

# Required only when RADAR_STORAGE=postgres.
# On Vercel: pooled URL at runtime, direct URL for `npm run prisma:deploy`.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/github_radar?schema=public"

# ── Snapshot collection endpoint ─────────────────────────────
# Protects POST /api/radar/collect and POST /api/radar/snapshots in production.
# Generate a random string, e.g. with: openssl rand -hex 32
CRON_SECRET=
